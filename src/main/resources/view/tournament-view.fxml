<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ScrollPane?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="gui.controller.TournamentController"
           styleClass="module-root">
    <!-- ===================================================
             OVERVIEW PANE
             =================================================== -->
    <VBox fx:id="overviewPane"
          spacing="18"
          styleClass="page-content">

        <!-- GRUPOS EN PARALELO (ARRIBA) -->
        <VBox spacing="10">
            <Label text="GROUP STAGE STANDINGS"
                   styleClass="section-caption"/>

            <ScrollPane fitToHeight="true"
                        styleClass="groups-scroll-pane">
                <HBox fx:id="allGroupsContainer"
                      spacing="16"
                      alignment="TOP_LEFT"/>
            </ScrollPane>
        </VBox>

        <!-- 4 CAJAS DE FASES ELIMINATORIAS (ABAJO) -->
        <VBox VBox.vgrow="ALWAYS" spacing="10">
            <Label text="KNOCKOUT ROUNDS &amp; CHAMPION"
                   styleClass="section-caption"/>

            <HBox spacing="16" VBox.vgrow="ALWAYS">

                <!-- 1. Cuartos de Final -->
                <VBox HBox.hgrow="ALWAYS"
                      spacing="8"
                      styleClass="panel">
                    <Label text="QUARTER-FINALS"
                           styleClass="small-text"/>
                    <VBox fx:id="overviewQuarterBox"
                          VBox.vgrow="ALWAYS"
                          spacing="6"/>
                </VBox>

                <!-- 2. Semifinales -->
                <VBox HBox.hgrow="ALWAYS"
                      spacing="8"
                      styleClass="panel">
                    <Label text="SEMI-FINALS"
                           styleClass="small-text"/>
                    <VBox fx:id="overviewSemiBox"
                          VBox.vgrow="ALWAYS"
                          spacing="6"/>
                </VBox>

                <!-- 3. Final -->
                <VBox HBox.hgrow="ALWAYS"
                      spacing="8"
                      styleClass="panel">
                    <Label text="FINAL"
                           styleClass="small-text"/>
                    <VBox fx:id="overviewFinalBox"
                          VBox.vgrow="ALWAYS"
                          spacing="6"/>
                </VBox>

                <!-- 4. Campeón -->
                <VBox HBox.hgrow="ALWAYS"
                      spacing="8"
                      alignment="CENTER"
                      styleClass="panel">
                    <Label text="CHAMPION"
                           styleClass="small-text"/>
                    <Label fx:id="overviewChampionName"
                           text="NOT WINNER YET"
                           styleClass="champion-text"
                           wrapText="true"
                           alignment="CENTER"/>
                </VBox>

            </HBox>
        </VBox>

    </VBox>


    <!-- ===================================================
         TEAMS
         =================================================== -->

    <HBox fx:id="teamsPane"
          visible="false"
          managed="false"
          spacing="16"
          styleClass="page-content">

        <VBox prefWidth="240"
              spacing="10"
              styleClass="panel">

            <Label text="CLUBS"
                   styleClass="section-caption"/>

            <ListView fx:id="teamList"
                      VBox.vgrow="ALWAYS"
                      styleClass="dark-list"/>

        </VBox>


        <VBox spacing="14"
              HBox.hgrow="ALWAYS">

            <!-- ENCABEZADO DESTACADO DEL EQUIPO -->
            <HBox alignment="CENTER_LEFT"
                  spacing="24"
                  styleClass="team-header-panel">

                <VBox spacing="6">

                    <Label fx:id="teamName"
                           text="-"
                           styleClass="team-header-title"/>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="teamCountry"
                               text="-"
                               styleClass="team-header-country"/>

                        <Label fx:id="teamRanking"
                               text="-"
                               styleClass="ranking-badge"/>
                    </HBox>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Tarjeta Squad Rating -->
                <VBox spacing="2"
                      styleClass="metric-card-highlight">

                    <Label text="SQUAD RATING"
                           styleClass="small-text"/>

                    <Label fx:id="teamOverall"
                           text="-"
                           styleClass="metric-value"/>

                </VBox>

                <!-- Tarjeta Head Coach -->
                <VBox spacing="4"
                      styleClass="coach-card">

                    <Label text="HEAD COACH"
                           styleClass="small-text"/>

                    <Label fx:id="coachName"
                           text="-"
                           styleClass="coach-name-label"/>

                    <Label fx:id="coachDetails"
                           text="-"
                           styleClass="coach-detail-label"/>

                </VBox>

            </HBox>


            <HBox spacing="16"
                  VBox.vgrow="ALWAYS">

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="panel">

                    <Label text="FIRST TEAM"
                           styleClass="section-title"/>

                    <TableView fx:id="playerTable"
                               VBox.vgrow="ALWAYS"
                               styleClass="dark-table">

                        <columns>

                            <TableColumn fx:id="playerNameColumn"
                                         text="PLAYER"
                                         prefWidth="180"/>

                            <TableColumn fx:id="playerPositionColumn"
                                         text="POS"
                                         prefWidth="80"/>

                            <TableColumn fx:id="playerOverallColumn"
                                         text="OVR"
                                         prefWidth="65"/>

                            <TableColumn fx:id="playerMatchesColumn"
                                         text="MP"
                                         prefWidth="55"/>

                            <TableColumn fx:id="playerMinutesColumn"
                                         text="MIN"
                                         prefWidth="65"/>

                            <TableColumn fx:id="playerGoalsColumn"
                                         text="GLS"
                                         prefWidth="55"/>

                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>


                <VBox prefWidth="340"
                      spacing="12"
                      styleClass="panel">

                    <Label text="PLAYER PROFILE"
                           styleClass="section-caption"/>

                    <Label fx:id="playerName"
                           text="-"
                           wrapText="true"
                           styleClass="player-title"/>

                    <Label fx:id="playerPosition"
                           text="-"
                           styleClass="accent-text"/>

                    <Label fx:id="playerNationality"
                           text="-"
                           styleClass="muted-text"/>

                    <Separator/>

                    <Label text="PERSONAL"
                           styleClass="small-text"/>

                    <Label fx:id="playerDocument"
                           text="-"
                           styleClass="info-value"/>

                    <Label fx:id="playerAge"
                           text="-"
                           styleClass="info-value"/>

                    <Separator/>

                    <Label text="RATING"
                           styleClass="small-text"/>

                    <Label fx:id="playerRating"
                           text="-"
                           styleClass="metric-value"/>

                    <Label text="TOURNAMENT STATS"
                           styleClass="small-text"/>

                    <Label fx:id="playerStats"
                           text="-"
                           wrapText="true"
                           styleClass="info-value"/>

                    <Label text="DISCIPLINE"
                           styleClass="small-text"/>

                    <Label fx:id="playerDiscipline"
                           text="-"
                           styleClass="info-value"/>

                    <Label fx:id="playerAvailability"
                           text="-"
                           styleClass="green-chip"/>

                    <Label fx:id="goalkeeperInformation"
                           text="-"
                           wrapText="true"
                           styleClass="goalkeeper-info"/>

                </VBox>

            </HBox>

        </VBox>

    </HBox>


    <!-- ===================================================
         BRACKET
         =================================================== -->

    <VBox fx:id="bracketPane"
          visible="false"
          managed="false"
          spacing="18"
          styleClass="page-content">

        <HBox alignment="CENTER_LEFT"
              styleClass="panel">

            <VBox spacing="4">

                <Label text="ROAD TO THE FINAL"
                       styleClass="section-title"/>

                <Label text="Only confirmed qualifiers are displayed"
                       styleClass="muted-text"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">

                <Label text="CHAMPION"
                       styleClass="small-text"/>

                <Label fx:id="championName"
                       text="NOT DEFINED"
                       styleClass="champion-text"/>

            </VBox>

        </HBox>


        <HBox spacing="24"
              VBox.vgrow="ALWAYS"
              styleClass="bracket-container">

            <!-- COLUMNA 1: CLASIFICADOS DE GRUPOS -->
            <VBox prefWidth="240"
                  spacing="10">

                <Label text="GROUPS STAGE"
                       maxWidth="Infinity"
                       styleClass="bracket-stage-header"/>

                <VBox fx:id="qualifiedBox"
                      alignment="CENTER"
                      spacing="10"
                      VBox.vgrow="ALWAYS"/>

            </VBox>

            <!-- COLUMNA 2: CUARTOS DE FINAL (4 series) -->
            <VBox prefWidth="260"
                  spacing="10">

                <Label text="QUARTER FINALS"
                       maxWidth="Infinity"
                       styleClass="bracket-stage-header"/>

                <VBox fx:id="quarterFinalBox"
                      alignment="CENTER"
                      spacing="18"
                      VBox.vgrow="ALWAYS"/>

            </VBox>

            <!-- COLUMNA 3: SEMIFINALES (2 series centradas) -->
            <VBox prefWidth="260"
                  spacing="10">

                <Label text="SEMIFINALS"
                       maxWidth="Infinity"
                       styleClass="bracket-stage-header"/>

                <VBox fx:id="semiFinalBox"
                      alignment="CENTER"
                      spacing="64"
                      VBox.vgrow="ALWAYS"/>

            </VBox>

            <!-- COLUMNA 4: GRAN FINAL (Centrada en el medio) -->
            <VBox prefWidth="280"
                  spacing="10">

                <Label text="FINAL"
                       maxWidth="Infinity"
                       styleClass="bracket-stage-header"/>

                <VBox fx:id="finalBox"
                      alignment="CENTER"
                      VBox.vgrow="ALWAYS"/>

            </VBox>

        </HBox>

    </VBox>


    <!-- ===================================================
             REPORTS PANE
             =================================================== -->
    <HBox fx:id="reportsPane"
          visible="false"
          managed="false"
          spacing="16"
          styleClass="page-content">

        <!-- Menú lateral izquierdo -->
        <VBox prefWidth="260"
              spacing="12"
              styleClass="panel">

            <Label text="REPORTS &amp; STATS"
                   styleClass="section-title"/>

            <ListView fx:id="reportList"
                      VBox.vgrow="ALWAYS"
                      styleClass="dark-list"/>

            <Button text="REFRESH CURRENT"
                    maxWidth="Infinity"
                    styleClass="secondary-button"
                    onAction="#handleRefreshReport"/>

        </VBox>

        <!-- Panel principal dinámico -->
        <VBox spacing="14"
              HBox.hgrow="ALWAYS"
              styleClass="panel">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="selectedReportTitle"
                           text="Report Overview"
                           styleClass="section-title-large"/>
                    <Label fx:id="selectedReportSubtitle"
                           text="Tournament analytical data"
                           styleClass="muted-text"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="reportMetricChip"
                       text="READY"
                       styleClass="purple-chip"/>
            </HBox>

            <!-- Contenedor dinámico (Reemplaza al viejo TextArea) -->
            <StackPane fx:id="reportContentHost"
                       VBox.vgrow="ALWAYS"
                       styleClass="report-content-host"/>

        </VBox>

    </HBox>

</StackPane>