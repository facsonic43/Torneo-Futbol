<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="gui.controller.TournamentController"
           styleClass="module-root">


    <!-- ===================================================
         OVERVIEW
         =================================================== -->

    <VBox fx:id="overviewPane"
          spacing="16"
          styleClass="page-content">

        <HBox spacing="16">

            <VBox prefWidth="220"
                  spacing="10"
                  styleClass="panel">

                <Label text="GROUPS"
                       styleClass="section-caption"/>

                <VBox fx:id="groupButtonsBox"
                      spacing="6"/>

            </VBox>


            <VBox spacing="10"
                  HBox.hgrow="ALWAYS"
                  styleClass="panel">

                <Label fx:id="selectedGroupTitle"
                       text="GROUP A"
                       styleClass="section-title"/>

                <HBox styleClass="table-header">

                    <Label text="#"
                           prefWidth="35"/>

                    <Label text="TEAM"
                           prefWidth="210"/>

                    <Label text="PTS"
                           prefWidth="55"/>

                    <Label text="MP"
                           prefWidth="55"/>

                    <Label text="GF"
                           prefWidth="55"/>

                    <Label text="GA"
                           prefWidth="55"/>

                    <Label text="GD"
                           prefWidth="55"/>

                </HBox>

                <VBox fx:id="standingsBox"
                      spacing="5"/>

            </VBox>


            <VBox prefWidth="270"
                  spacing="12"
                  styleClass="panel">

                <Label text="TOURNAMENT"
                       styleClass="section-caption"/>

                <VBox spacing="4"
                      styleClass="info-card">

                    <Label text="CURRENT STAGE"
                           styleClass="small-text"/>

                    <Label fx:id="overviewStage"
                           text="-"
                           styleClass="metric-value"/>

                </VBox>

                <VBox spacing="4"
                      styleClass="info-card">

                    <Label text="MATCHES"
                           styleClass="small-text"/>

                    <Label fx:id="overviewMatches"
                           text="-"
                           styleClass="metric-value"/>

                </VBox>

                <VBox spacing="4"
                      styleClass="info-card">

                    <Label text="CHAMPION"
                           styleClass="small-text"/>

                    <Label fx:id="overviewChampion"
                           text="-"
                           wrapText="true"
                           styleClass="info-value"/>

                </VBox>

            </VBox>

        </HBox>


        <HBox spacing="16">

            <VBox styleClass="stat-card"
                  HBox.hgrow="ALWAYS">

                <Label text="TOP SCORER"
                       styleClass="card-caption"/>

                <Label fx:id="overviewScorer"
                       text="-"
                       styleClass="card-value"/>

            </VBox>

            <VBox styleClass="stat-card"
                  HBox.hgrow="ALWAYS">

                <Label text="MOST MINUTES"
                       styleClass="card-caption"/>

                <Label fx:id="overviewMinutes"
                       text="-"
                       styleClass="card-value"/>

            </VBox>

            <VBox styleClass="stat-card"
                  HBox.hgrow="ALWAYS">

                <Label text="FAIR PLAY"
                       styleClass="card-caption"/>

                <Label fx:id="overviewFairPlay"
                       text="-"
                       styleClass="card-value"/>

            </VBox>

        </HBox>

    </VBox>


    <!-- ===================================================
         TEAMS
         =================================================== -->

    <HBox fx:id="teamsPane"
          visible="false"
          managed="false"
          spacing="16"
          styleClass="page-content">

        <VBox prefWidth="240"
              spacing="10"
              styleClass="panel">

            <Label text="CLUBS"
                   styleClass="section-caption"/>

            <ListView fx:id="teamList"
                      VBox.vgrow="ALWAYS"
                      styleClass="dark-list"/>

        </VBox>


        <VBox spacing="14"
              HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT"
                  spacing="18"
                  styleClass="panel">

                <VBox spacing="4">

                    <Label fx:id="teamName"
                           text="-"
                           styleClass="team-title"/>

                    <Label fx:id="teamCountry"
                           text="-"
                           styleClass="muted-text"/>

                    <Label fx:id="teamRanking"
                           text="-"
                           styleClass="purple-chip"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox spacing="3"
                      styleClass="info-card">

                    <Label text="SQUAD RATING"
                           styleClass="small-text"/>

                    <Label fx:id="teamOverall"
                           text="-"
                           styleClass="metric-value"/>

                </VBox>

                <VBox spacing="3"
                      styleClass="info-card">

                    <Label text="HEAD COACH"
                           styleClass="small-text"/>

                    <Label fx:id="coachName"
                           text="-"
                           wrapText="true"
                           styleClass="info-value"/>

                </VBox>

            </HBox>


            <HBox spacing="16"
                  VBox.vgrow="ALWAYS">

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="panel">

                    <Label text="FIRST TEAM"
                           styleClass="section-title"/>

                    <TableView fx:id="playerTable"
                               VBox.vgrow="ALWAYS"
                               styleClass="dark-table">

                        <columns>

                            <TableColumn fx:id="playerNameColumn"
                                         text="PLAYER"
                                         prefWidth="185"/>

                            <TableColumn fx:id="playerPositionColumn"
                                         text="POS"
                                         prefWidth="100"/>

                            <TableColumn fx:id="playerOverallColumn"
                                         text="OVR"
                                         prefWidth="60"/>

                            <TableColumn fx:id="playerMatchesColumn"
                                         text="MP"
                                         prefWidth="50"/>

                            <TableColumn fx:id="playerMinutesColumn"
                                         text="MIN"
                                         prefWidth="65"/>

                            <TableColumn fx:id="playerGoalsColumn"
                                         text="GLS"
                                         prefWidth="50"/>

                        </columns>

                    </TableView>

                </VBox>


                <VBox prefWidth="340"
                      spacing="12"
                      styleClass="panel">

                    <Label text="PLAYER PROFILE"
                           styleClass="section-caption"/>

                    <Label fx:id="playerName"
                           text="-"
                           wrapText="true"
                           styleClass="player-title"/>

                    <Label fx:id="playerPosition"
                           text="-"
                           styleClass="accent-text"/>

                    <Label fx:id="playerNationality"
                           text="-"
                           styleClass="muted-text"/>

                    <Separator/>

                    <Label text="PERSONAL"
                           styleClass="small-text"/>

                    <Label fx:id="playerDocument"
                           text="-"
                           styleClass="info-value"/>

                    <Label fx:id="playerAge"
                           text="-"
                           styleClass="info-value"/>

                    <Separator/>

                    <Label text="RATING"
                           styleClass="small-text"/>

                    <Label fx:id="playerRating"
                           text="-"
                           styleClass="metric-value"/>

                    <Label text="TOURNAMENT STATS"
                           styleClass="small-text"/>

                    <Label fx:id="playerStats"
                           text="-"
                           wrapText="true"
                           styleClass="info-value"/>

                    <Label text="DISCIPLINE"
                           styleClass="small-text"/>

                    <Label fx:id="playerDiscipline"
                           text="-"
                           styleClass="info-value"/>

                    <Label fx:id="playerAvailability"
                           text="-"
                           styleClass="green-chip"/>

                    <Label fx:id="goalkeeperInformation"
                           text="-"
                           wrapText="true"
                           styleClass="goalkeeper-info"/>

                </VBox>

            </HBox>

        </VBox>

    </HBox>


    <!-- ===================================================
         BRACKET
         =================================================== -->

    <VBox fx:id="bracketPane"
          visible="false"
          managed="false"
          spacing="18"
          styleClass="page-content">

        <HBox alignment="CENTER_LEFT"
              styleClass="panel">

            <VBox spacing="4">

                <Label text="ROAD TO THE FINAL"
                       styleClass="section-title"/>

                <Label text="Only confirmed qualifiers are displayed"
                       styleClass="muted-text"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT">

                <Label text="CHAMPION"
                       styleClass="small-text"/>

                <Label fx:id="championName"
                       text="NOT DEFINED"
                       styleClass="champion-text"/>

            </VBox>

        </HBox>


        <HBox spacing="24"
              styleClass="bracket-container">

            <VBox prefWidth="260"
                  spacing="10">

                <Label text="QUALIFIED"
                       styleClass="bracket-stage"/>

                <VBox fx:id="qualifiedBox"
                      spacing="12"/>

            </VBox>


            <VBox prefWidth="280"
                  spacing="10">

                <Label text="QUARTER-FINALS"
                       styleClass="bracket-stage"/>

                <VBox fx:id="quarterFinalBox"
                      spacing="12"/>

            </VBox>


            <VBox prefWidth="280"
                  spacing="10">

                <Label text="SEMI-FINALS"
                       styleClass="bracket-stage"/>

                <VBox fx:id="semiFinalBox"
                      spacing="24"/>

            </VBox>


            <VBox prefWidth="280"
                  spacing="10">

                <Label text="FINAL"
                       styleClass="bracket-stage"/>

                <VBox fx:id="finalBox"
                      spacing="12"/>

            </VBox>

        </HBox>

    </VBox>


    <!-- ===================================================
         REPORTS
         =================================================== -->

    <HBox fx:id="reportsPane"
          visible="false"
          managed="false"
          spacing="16"
          styleClass="page-content">

        <VBox prefWidth="280"
              spacing="12"
              styleClass="panel">

            <Label text="REPORTS"
                   styleClass="section-title"/>

            <ListView fx:id="reportList"
                      VBox.vgrow="ALWAYS"
                      styleClass="dark-list"/>

            <Label text="PLAYER POSITION"
                   styleClass="small-text"/>

            <ComboBox fx:id="positionFilter"
                      maxWidth="Infinity"
                      promptText="ALL POSITIONS"/>

            <Button text="ALL POSITIONS"
                    maxWidth="Infinity"
                    styleClass="secondary-button"
                    onAction="#handleAllPositions"/>

        </VBox>


        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              styleClass="panel">

            <HBox alignment="CENTER_LEFT">

                <Label fx:id="selectedReportTitle"
                       text="Report"
                       styleClass="section-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="REFRESH"
                        styleClass="primary-button"
                        onAction="#handleRefreshReport"/>

            </HBox>

            <TextArea fx:id="reportArea"
                      editable="false"
                      wrapText="false"
                      VBox.vgrow="ALWAYS"
                      styleClass="report-area"/>

        </VBox>

    </HBox>

</StackPane>