<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controller.MainController"
            styleClass="app-root">

    <top>

        <VBox>

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="top-navigation">

                <VBox spacing="1"
                      styleClass="brand">

                    <Label text="INTERNATIONAL CLUB CUP"
                           styleClass="brand-title"/>

                    <Label text="TOURNAMENT 2026"
                           styleClass="brand-subtitle"/>

                </VBox>

                <Button fx:id="tournamentButton"
                        text="TOURNAMENT"
                        styleClass="nav-button"
                        onAction="#handleTournament"/>

                <Button fx:id="teamsButton"
                        text="TEAMS"
                        styleClass="nav-button"
                        onAction="#handleTeams"/>

                <Button fx:id="matchDayButton"
                        text="MATCH DAY"
                        styleClass="nav-button"
                        onAction="#handleMatchDay"/>

                <Button fx:id="bracketButton"
                        text="BRACKET"
                        styleClass="nav-button"
                        onAction="#handleBracket"/>

                <Button fx:id="reportsButton"
                        text="REPORTS"
                        styleClass="nav-button"
                        onAction="#handleReports"/>

                <Button fx:id="databaseButton"
                        text="DATABASE"
                        styleClass="nav-button"
                        onAction="#handleDatabase"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="SAVE"
                        styleClass="utility-button"
                        onAction="#handleSave"/>

                <Button text="LOAD"
                        styleClass="utility-button"
                        onAction="#handleLoad"/>

                <Button text="CONTINUE  >>"
                        styleClass="primary-button"
                        onAction="#handleContinue"/>

            </HBox>


            <HBox alignment="CENTER_LEFT"
                  styleClass="page-header">

                <VBox spacing="3">

                    <Label fx:id="pageTitle"
                           text="Tournament Overview"
                           styleClass="page-title"/>

                    <Label fx:id="pageSubtitle"
                           text="International Club Cup 2026"
                           styleClass="page-subtitle"/>

                </VBox>

            </HBox>

        </VBox>

    </top>


    <center>

        <StackPane fx:id="contentHost"
                   styleClass="content-host"/>

    </center>


    <bottom>

        <Label fx:id="statusLabel"
               maxWidth="Infinity"
               text="Application ready."
               styleClass="status-bar"/>

    </bottom>

</BorderPane>