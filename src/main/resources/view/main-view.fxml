<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.controller.MainController"
            styleClass="app-root">

    <top>

        <VBox>

            <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
            <!-- BARRA DE NAVEGACIÓN SUPERIOR -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="top-navigation">

                <ImageView fx:id="brandLogo"
                           fitWidth="330"
                           fitHeight="90"
                           preserveRatio="true"
                           styleClass="brand-logo"/>

                <!-- SOLAPAS DE NAVEGACIÓN -->
                <Button fx:id="tournamentButton"
                        text="TOURNAMENT"
                        styleClass="nav-button"
                        onAction="#handleTournament"/>

                <Button fx:id="teamsButton"
                        text="TEAMS"
                        styleClass="nav-button"
                        onAction="#handleTeams"/>

                <Button fx:id="matchDayButton"
                        text="MATCH DAY"
                        styleClass="nav-button"
                        onAction="#handleMatchDay"/>

                <Button fx:id="bracketButton"
                        text="BRACKET"
                        styleClass="nav-button"
                        onAction="#handleBracket"/>

                <Button fx:id="reportsButton"
                        text="REPORTS"
                        styleClass="nav-button"
                        onAction="#handleReports"/>

                <Button fx:id="databaseButton"
                        text="DATABASE"
                        styleClass="nav-button"
                        onAction="#handleDatabase"/>

                <!-- ESPACIADOR IZQUIERDO PARA CENTRADO -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- INDICADORES GLOBALES: CURRENT STAGE & MATCHES (MÁS GRANDES Y SIN RAYAS) -->
                <HBox fx:id="globalTournamentStatusBox"
                      alignment="CENTER"
                      spacing="28"
                      style="-fx-padding: 0 16;">

                    <VBox alignment="CENTER" spacing="3">
                        <Label text="CURRENT STAGE"
                               styleClass="small-text"
                               style="-fx-font-size: 11px; -fx-font-weight: 800;"/>
                        <Label fx:id="mainStageLabel"
                               text="GROUP STAGE"
                               styleClass="metric-value"
                               style="-fx-font-size: 16px; -fx-font-weight: 900;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="3">
                        <Label text="MATCHES"
                               styleClass="small-text"
                               style="-fx-font-size: 11px; -fx-font-weight: 800;"/>
                        <Label fx:id="mainMatchesLabel"
                               text="0 / 37"
                               styleClass="metric-value"
                               style="-fx-font-size: 16px; -fx-font-weight: 900;"/>
                    </VBox>

                </HBox>

                <!-- ESPACIADOR DERECHO PARA EQUILIBRAR EL CENTRADO -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- BOTONES DE ACCIÓN Y UTILIDADES -->
                <Button text="SAVE"
                        styleClass="utility-button"
                        onAction="#handleSave"/>

                <Button text="LOAD"
                        styleClass="utility-button"
                        onAction="#handleLoad"/>

                <Button fx:id="themeButton"
                        text="☀"
                        styleClass="utility-button"
                        onAction="#handleThemeToggle"/>

                <Button text="CONTINUE  &gt;&gt;"
                        styleClass="primary-button"
                        onAction="#handleContinue"/>

            </HBox>

            <!-- ENCABEZADO DE PÁGINA (TÍTULO Y SUBTÍTULO) -->
            <HBox alignment="CENTER"
                  styleClass="page-header">

                <VBox alignment="CENTER"
                      spacing="2">

                    <Label fx:id="pageTitle"
                           text="Tournament Overview - International Club Cup 2026"
                           alignment="CENTER"
                           textAlignment="CENTER"
                           styleClass="page-title"/>

                    <Label fx:id="pageSubtitle"
                           text=""
                           visible="false"
                           managed="false"
                           alignment="CENTER"
                           textAlignment="CENTER"
                           styleClass="page-subtitle"/>

                </VBox>

            </HBox>

        </VBox>

    </top>

    <center>

        <StackPane fx:id="contentHost"
                   styleClass="content-host"/>

    </center>


    <bottom>

        <Label fx:id="statusLabel"
               maxWidth="Infinity"
               text="Application ready."
               styleClass="status-bar"/>

    </bottom>

</BorderPane>